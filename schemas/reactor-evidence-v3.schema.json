{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gnomeman4201.github.io/gnome-prompt-field-manual/schemas/reactor-evidence-v3.schema.json",
  "title":"GNOME Phase VIII-C evidence capsule v3 (self-contained, no external authentication)",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","campaign","interventions","execution","evaluation","findings","integrity"],
  "properties":{
    "schemaVersion":{"const":"gnome.reactor.evidence.v3"},
    "campaign":{"type":"object","additionalProperties":false,"required":["schemaVersion","campaignId","family","plan","references","protocol"],
      "properties":{"schemaVersion":{"const":"gnome.reactor.campaign.v3"},"campaignId":{"type":"string","minLength":1},
      "family":{"enum":["A_EVIDENCE_BOUNDARY","B_LOWER_TRUST_INJECTION","C_EVALUATOR_CONTAMINATION"]},
      "plan":{"type":"object"},"references":{"type":"array","minItems":1,"items":{"type":"object"}},
      "protocol":{"type":"object","required":["researchMode"],"properties":{"researchMode":{"enum":["EXPLORATORY","CONFIRMATORY"]}}},
      "isSyntheticDemo":{"type":"boolean"}}},
    "interventions":{"type":"object","required":["schemaVersion","interventionId","type","controlPromptHash","variantPromptHash","fixedTaskHash","fixedConfigHash"],
      "properties":{"schemaVersion":{"const":"gnome.reactor.intervention.v1"},
      "interventionId":{"type":"string","minLength":1},"type":{"enum":["PROMPT_VARIANT","LOWER_TRUST_DOCUMENT"]},
      "controlPromptHash":{"$ref":"#/$defs/hash"},"variantPromptHash":{"$ref":"#/$defs/hash"},
      "fixedTaskHash":{"$ref":"#/$defs/hash"},"fixedConfigHash":{"$ref":"#/$defs/hash"}}},
    "execution":{"type":"object","additionalProperties":false,"required":["status","observations","errors","modelProvenance"],
      "properties":{"schemaVersion":{"type":"string"},
      "status":{"enum":["NOT_EXECUTED","PARTIAL","COMPLETED"]},
      "observations":{"type":"array","maxItems":1024,"items":{"type":"object"}},
      "errors":{"type":"array","items":{"type":"object"}},
      "modelProvenance":{"enum":["PROVIDER_REPORTED_UNAUTHENTICATED","SYNTHETIC_MOCK_TEST_ONLY","NOT_AVAILABLE"]},
      "claimsVerified":{"type":"boolean"}}},
    "evaluation":{"type":"object","required":["schemaVersion","executionStatus","counts","outcomes","replayMode"]},
    "findings":{"type":"object","additionalProperties":false,"required":["claims"],
      "properties":{"claims":{"type":"array","items":{"type":"object","required":["claimId","status","trialRefs","statement"],
      "properties":{"claimId":{"type":"string"},"status":{"enum":["INCONCLUSIVE","NOT_SUPPORTED","CONTRADICTED","CANDIDATE_REQUIRES_REVIEW","SUPPORTED_WITHIN_RECORDED_CONDITIONS"]},
      "trialRefs":{"type":"array","items":{"type":"string"}},"statement":{"type":"string"}}}},
      "challenges":{"type":"array","items":{"type":"object"}}}},
    "integrity":{"type":"object","additionalProperties":false,"required":["manifest","checksums"],
      "properties":{"manifest":{"type":"object","additionalProperties":false,
        "required":["schemaVersion","authentication","replayMode","isSyntheticDemo"],
        "properties":{"schemaVersion":{"const":"gnome.reactor.evidence.v3"},
          "authentication":{"const":"UNAUTHENTICATED_CONTENT_CHECKSUMS_ONLY"},
          "replayMode":{"const":"COMPUTATIONAL_REPLAY_ONLY"},
          "isSyntheticDemo":{"type":"boolean"}}},
      "checksums":{"type":"object","additionalProperties":false,
        "required":["campaign","interventions","execution","evaluation","findings","manifest"],
        "properties":{"campaign":{"$ref":"#/$defs/hash"},"interventions":{"$ref":"#/$defs/hash"},
          "execution":{"$ref":"#/$defs/hash"},"evaluation":{"$ref":"#/$defs/hash"},
          "findings":{"$ref":"#/$defs/hash"},"manifest":{"$ref":"#/$defs/hash"}}}}}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
