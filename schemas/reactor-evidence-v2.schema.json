{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gnomeman4201.github.io/gnome-prompt-field-manual/schemas/reactor-evidence-v2.schema.json",
  "title":"GNOME Evidence Spine v2 deterministic replay capsule",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","manifest","payload","integrity"],
  "properties":{
    "schemaVersion":{"const":"gnome.reactor.evidence.v2"},
    "manifest":{"type":"object","additionalProperties":false,
      "required":["schemaVersion","planId","planHash","sourceSha256","referenceAuthority","isSyntheticDemo","replayMode"],
      "properties":{"schemaVersion":{"const":"gnome.reactor.evidence.v2"},"planId":{"type":"string"},
        "planHash":{"$ref":"#/$defs/sha256"},"sourceSha256":{"$ref":"#/$defs/sha256"},
        "referenceAuthority":{"const":"REVIEWER_SUPPLIED_UNAUTHENTICATED"},"isSyntheticDemo":{"type":"boolean"},
        "replayMode":{"const":"COMPUTATIONAL_REPLAY_ONLY"}}},
    "payload":{"type":"object","additionalProperties":false,
      "required":["plan","observations","analysis"],
      "properties":{"plan":{"$ref":"reactor-evaluation-plan-v2.schema.json"},
        "observations":{"type":"array","minItems":1,"maxItems":1024,"items":{"type":"object"}},
        "analysis":{"type":"object"}}},
    "integrity":{"type":"object","additionalProperties":false,"required":["checksums"],
      "properties":{"checksums":{"type":"object","additionalProperties":false,
        "required":["manifest.json","plan.json","observations.json","analysis.json"],
        "properties":{"manifest.json":{"$ref":"#/$defs/sha256"},"plan.json":{"$ref":"#/$defs/sha256"},
          "observations.json":{"$ref":"#/$defs/sha256"},"analysis.json":{"$ref":"#/$defs/sha256"}}}}}
  },
  "$defs":{"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
}
