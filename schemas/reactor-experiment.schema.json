{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GNOME Evidence Reactor Experiment",
  "type": "object",
  "required": [
    "schemaVersion",
    "experimentId",
    "hypothesis",
    "controlPromptHash",
    "variantPromptHash",
    "dataset",
    "rubric",
    "modelConfig"
  ],
  "properties": {
    "schemaVersion": {
      "const": "gnome.reactor.experiment.v1"
    },
    "experimentId": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "independentVariable": {
      "type": "string"
    },
    "dependentVariables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controlPromptHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variantPromptHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset": {
      "type": "object",
      "required": [
        "datasetId",
        "inputs"
      ],
      "properties": {
        "datasetId": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "inputId"
            ],
            "properties": {
              "inputId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "rubric": {
      "type": "object",
      "required": [
        "criteria"
      ],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "modelConfig": {
      "type": "object",
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  }
}
